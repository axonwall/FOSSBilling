    "content": "\n<!DOCTYPE html>\n<html>\n<head>\n\t<meta charset=\"utf-8\">\n\t<style type=\"text/css\">\n\t\tbody {\n\t\t\tfont-family: Arial, sans-serif;\n\t\t\tfont-size: 14px;\n\t\t\tcolor: #333333;\n\t\t}\n\n\t\th1 {\n\t\t\tfont-size: 24px;\n\t\t\tfont-weight: bold;\n\t\t\tmargin: 0 0 20px;\n\t\t}\n\n\t\tp {\n\t\t\tmargin: 0 0 10px;\n\t\t}\n\n\t\tstrong {\n\t\t\tfont-weight: bold;\n\t\t}\n\n\t\t.signature {\n\t\t\tfont-style: italic;\n\t\t\tcolor: #999999;\n\t\t\tmargin-top: 20px;\n\t\t\tborder-top: 1px solid #cccccc;\n\t\t\tpadding-top: 10px;\n\t\t}\n\t</style>\n</head>\n<body>\n\t<h1>Welcome</h1>\n\t<p>Thank you for signing up with us. Your new account has been setup and you can now login to our client area using the details below:</p>\n    <ul>\n        <li><strong>Email:</strong> {{ c.email|default('') }}</li>\n    </ul>\n\n    <p>Please use the password you chose during signup when logging in.</p>\n\n    {% if require_email_confirmation|default(false) %}\n        <p>Please verify your email by clicking on the link below:</p>\n        <a href=\"{{ email_confirmation_link|default('#') }}\" target=\"_blank\">Verify email address.</a>\n    {% endif %}\n\n    <p>You may <a href=\"{{ 'login'|url(query: { 'email': c.email|default('') }, area: 'client') }}\" target=\"_blank\">login</a> or <a href=\"{{ 'client/profile'|url(area: 'client') }}\" target=\"_blank\">edit your profile.</a>\n\n\t<div class=\"signature\">{{ guest.system_email.signature }}</div>\n</body>\n</html>\n",
