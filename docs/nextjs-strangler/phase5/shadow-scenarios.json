  {
   "description": "Client-session checkout: the guest cart endpoints are session-based, so the LOGGED-IN client jar drives them (same session through add and checkout). The earlier separate-jar shape proved only that both stacks fail identically on an orphaned guest cart (empty-cart error, no order) \u2014 it never exercised checkout. Anonymous-add-then-login cart migration is NOT covered by either shape.",
   "id": "cart-checkout",
   "seed_ops": [],
   "seed_sql": [],
   "steps": [
    {
     "as": "client",
     "call": "guest/cart/reset",
     "params": {}
    },
    {
     "as": "client",
     "call": "guest/cart/add_item",
     "params": {
      "id": 3
     }
    },
    {
     "as": "client",
     "call": "guest/cart/get",
     "params": {}
    },
    {
     "as": "client",
     "call": "client/cart/checkout",
     "params": {
      "gateway_id": 1
     },
     "save": {
      "invhash": "result.invoice_hash",
      "ord": "result.order_id"
     }
    },
    {
     "as": "client",
     "call": "client/invoice/get",
     "params": {
      "hash": "$invhash"
     }
    }
   ]
  },
